{
  "schema_version": "arckit-capability/v1",
  "id": "arckit-debug-diagnosis",
  "kind": "diagnosis",
  "runtime_role": ["work_executor", "verification_agent"],
  "binding_targets": ["worker"],
  "summary": "依据证据诊断缺陷、回归、失败、数据问题、UI 缺陷和性能异常。",
  "input_facts": [
    "symptom",
    "logs",
    "tests",
    "code",
    "runtime_events"
  ],
  "outputs": [
    "diagnosis_report",
    "fix_recommendation",
    "verification_evidence"
  ],
  "allowed_write_targets": [
    "."
  ],
  "forbidden_decisions": [
    "product_requirement_final",
    "architecture_rewrite_without_decision",
    "case_closed"
  ],
  "runtime_notes": [
    "作为执行能力使用；将稳定预期的变更交回维护结果事实的技能处理。"
  ]
}
