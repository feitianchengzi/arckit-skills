{
  "schema_version": "arckit-capability/v1",
  "id": "arckit-spec",
  "kind": "result_fact_source",
  "runtime_role": ["fact_source_maintenance"],
  "binding_targets": ["agent"],
  "summary": "维护稳定的产品行为、规则、功能规格和验收标准。",
  "input_facts": [
    "relevant_product_facts",
    "accepted_decision",
    "validated_scenario",
    "dynamic_case_gap"
  ],
  "outputs": [
    "spec_update",
    "spec_audit",
    "acceptance_criteria",
    "fact_result"
  ],
  "allowed_write_targets": [
    "arckit/spec/**"
  ],
  "forbidden_decisions": [
    "implementation_only_as_requirement",
    "unconfirmed_assumption_as_fact",
    "visual_or_technical_fact_ownership"
  ],
  "runtime_notes": [
    "智能体仅在当前动态缺口需要产品事实时调用托管案例（`managed-case`）模式；技能返回有证据支持的 `fact_result`，独立（`standalone`）模式仍可使用。",
    "仅用于稳定的产品预期事实；未知事项保留在活跃 `Case` 中，绝不声称 `Case` 已解决。"
  ]
}
