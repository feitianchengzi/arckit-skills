{
  "schema_version": "arckit-capability/v1",
  "id": "arckit-interaction",
  "kind": "result_fact_source",
  "runtime_role": [
    "fact_source_maintenance"
  ],
  "binding_targets": [
    "agent"
  ],
  "summary": "维护交互预期策略、可交互原型和说明，支持独立存放的候选探索与采纳。",
  "input_facts": [
    "relevant_product_facts",
    "relevant_interaction_facts",
    "validated_scenario",
    "dynamic_case_gap"
  ],
  "outputs": [
    "interaction_update",
    "interaction_audit",
    "interaction_acceptance_criteria",
    "fact_result",
    "exploration_result"
  ],
  "allowed_write_targets": [
    "arckit/interaction/**"
  ],
  "forbidden_decisions": [
    "unconfirmed_assumption_as_fact",
    "visual_direction_final_without_human_basis",
    "technical_fact_ownership"
  ],
  "runtime_notes": [
    "智能体仅在当前动态缺口需要交互事实时调用托管案例（`managed-case`）模式；技能返回有证据支持的 `fact_result`，独立（`standalone`）模式仍可使用。",
    "候选产物保留在本域的 `_explorations` 目录；回传未解决的取舍，不声称稳定事实已更新，不写 `Case State`。用户已有决定即为采纳授权；绝不从实现推断已获批准。"
  ]
}
